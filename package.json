{
  "name": "nestjs-microservices",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:producer": "ts-node -P apps/producer/tsconfig.json apps/producer/src/main.ts",
    "start:consumer": "ts-node -P apps/consumer/tsconfig.json apps/consumer/src/main.ts",
    "build:producer": "tsc -p apps/producer/tsconfig.json --outDir dist/producer",
    "build:consumer": "tsc -p apps/consumer/tsconfig.json --outDir dist/consumer",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest.config.js --testPathPattern=e2e"
  },
  "dependencies": {
    "@nestjs/common": "^9.3.12",
    "@nestjs/core": "^9.3.12",
    "@nestjs/microservices": "^9.3.12",
    "@nestjs/platform-express": "^9.3.12",
    "@nestjs/swagger": "^6.3.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.3.0",
    "@nestjs/schematics": "^9.2.0",
    "@nestjs/testing": "^9.3.12",
    "@types/amqplib": "^0.10.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.1",
    "jest": "^29.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}
